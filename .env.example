# --- Site identity ---------------------------------------------------------
NEXT_PUBLIC_SITE_NAME=GlobeGuard
# Public origin of the storefront (no trailing slash). Used for metadata,
# canonical URLs, sitemap.xml and robots.txt. A host containing "beta."
# makes robots.txt disallow everything.
NEXT_PUBLIC_SITE_URL=http://localhost:3001

# --- Vendure ---------------------------------------------------------------
# Vendure Shop API URL (required, server-side only)
VENDURE_SHOP_API_URL=http://localhost:3000/shop-api
# Or use the public variant if needed client-side
# NEXT_PUBLIC_VENDURE_SHOP_API_URL=http://localhost:3000/shop-api

# Vendure Channel Token (optional, defaults to __default_channel__)
VENDURE_CHANNEL_TOKEN=__default_channel__
# NEXT_PUBLIC_VENDURE_CHANNEL_TOKEN=__default_channel__

# Hostname (no protocol, no path) that serves Vendure product assets.
# Added to next/image remotePatterns over https. localhost/127.0.0.1 are
# always allowed outside production.
NEXT_PUBLIC_ASSET_HOST=

# --- Cache revalidation ----------------------------------------------------
# Secret for the /api/revalidate endpoint. Generate with: openssl rand -base64 32
REVALIDATION_SECRET=replace-with-secure-random-string

# --- Optional Vendure header/cookie names ---------------------------------
# VENDURE_AUTH_TOKEN_COOKIE=vendure-auth-token
# VENDURE_AUTH_TOKEN_HEADER=vendure-auth-token
# VENDURE_CHANNEL_TOKEN_HEADER=vendure-token
